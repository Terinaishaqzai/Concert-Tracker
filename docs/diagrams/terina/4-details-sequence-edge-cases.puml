@startuml
title Concert Details - Concert Not Found / Event Ended
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
hide circle

actor User
participant "index.html" as UI
participant ConcertDetailsController as Ctrl
participant ConcertDetailsService as Svc
participant SqliteConcertRepository as Repo
database "concerts.db" as DB

User -> UI : click concert card
UI -> Ctrl : GET /api/concerts/details?id=99
Ctrl -> Svc : getDetails(99)
Svc -> Repo : findById(99)
Repo -> DB : SELECT * FROM concerts WHERE id = ?
DB --> Repo : result

alt no concert with that id
  Repo --> Svc : empty
  Svc --> Ctrl : ConcertNotFoundException
  Ctrl --> UI : 404 Not Found
  UI --> User : "Concert not found"
else concert date already passed
  Repo --> Svc : Concert
  Svc -> Svc : getStatus(c) = "Event Ended"
  Svc --> Ctrl : ConcertDetails
  Ctrl --> UI : 200 OK (JSON)
  UI --> User : details, no ticket link
end
@enduml
